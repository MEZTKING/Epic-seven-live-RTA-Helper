rules_version = '2';
// Epic 7 Engine — Guild War sharing.
// Data lives at guilds/{guildCode}/records/{id}. Users sign in anonymously
// (no email). The long random guild code is the shared secret: anyone who has
// it can read and write that guild's records, nothing else.
service cloud.firestore {
  match /databases/{database}/documents {
    match /guilds/{guild}/records/{record} {
      allow read: if request.auth != null && guild.size() >= 12;
      allow write: if request.auth != null
        && guild.size() >= 12
        && request.resource.data.keys().size() < 40
        && request.resource.data.get('type', '') in ['member', 'war', 'target', 'attack', 'defense', 'settings', 'hero', '']
        && request.resource.size() < 50000;
    }
    // My devices sync (js/mysync.js): personal/{key}/sections/{id} and personal/{key}/chunks/{id}~{i}.
    // The long random key (36 hex chars) is the secret; only someone with your link can read or write it.
    match /personal/{key}/{coll}/{doc} {
      allow read: if request.auth != null && key.size() >= 32;
      allow write: if request.auth != null
        && key.size() >= 32
        && coll in ['sections', 'chunks']
        && request.resource.size() < 1000000;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
